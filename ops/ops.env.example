# EduTrack operations settings.
#
# Lives on the server at /etc/edutrack/ops.env (owner root, mode 600) and is read
# by edutrack-backup, edutrack-restore, edutrack-restic and edutrack-deploy.
#
# There are no passwords in this file. The backup encryption password and the
# Google Drive login live in the two files it points at further down.
#
# Guide: ops/guides/01-backups.md

# ── The app ───────────────────────────────────────────────────────────────────
# Where the git checkout is, the Linux account that owns it and runs gunicorn,
# the systemd service name, and the branch edutrack-deploy puts live.
REPO_DIR=/var/www/edutrack
APP_USER=edutrack
SERVICE=edutrack
BRANCH=master
# Checked after a deploy or a restore to prove the site answers.
APP_URL=http://127.0.0.1:8000/login/

# ── The database (the same names as DB_NAME and DB_USER in backend/.env) ─────
DB_NAME=edutrack_db
DB_USER=edutrack_user

# ── Copies kept on this server ────────────────────────────────────────────────
BACKUP_ROOT=/var/backups/edutrack
# Nightly database dumps kept in $BACKUP_ROOT/daily.
LOCAL_KEEP=7
# Dumps edutrack-deploy takes before migrating, kept in $BACKUP_ROOT/pre-deploy.
PRE_DEPLOY_KEEP=10

# ── The off-site copy in Google Drive, encrypted by restic ───────────────────
RESTIC_REPOSITORY=rclone:gdrive:edutrack-backups
RESTIC_PASSWORD_FILE=/etc/edutrack/restic-password
RCLONE_CONFIG=/etc/edutrack/rclone.conf
# One per day for a week, one per week for a month, one per month for a year.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# ── Optional: be told when a backup does not happen ──────────────────────────
# A free check from https://healthchecks.io, e.g. https://hc-ping.com/1a2b3c...
# Leave it empty to switch this off.
HEALTHCHECK_URL=
