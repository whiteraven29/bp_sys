# Source: ops/ansible/templates/edutrack.service.j2 — change that file and run
# the playbook; edits made here by hand are overwritten.

[Unit]
Description=EduTrack Gunicorn Daemon
After=network.target postgresql.service

[Service]
User={{ app_user }}
Group=www-data
WorkingDirectory={{ backend_dir }}
ExecStart={{ backend_dir }}/venv/bin/gunicorn \
    edutrack.wsgi \
    --bind {{ gunicorn_bind }} \
    --workers {{ gunicorn_workers }} \
{% if gunicorn_threads | int > 1 %}
    --worker-class gthread \
    --threads {{ gunicorn_threads }} \
{% endif %}
    --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
